<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout android:id="@+id/drawer_layout" android:fitsSystemWindows="true" android:layout_width="fill_parent" android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:baselineAligned="false"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    tools:context="organotiki.mobile.NorthnetStatistics.MainScreen">

    <include
        android:id="@+id/mainScreenBar"
        layout="@layout/main_screen_bar"
        android:baselineAligned="false" />

    <ImageView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:src="@drawable/logoo_icon"
        android:alpha="0.1"
        android:scaleType="centerInside"
        >

    </ImageView>

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@+id/mainScreenBar"
        android:baselineAligned="false"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        tools:context="organotiki.mobile.mobilestore.MainScreen">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/LLuser">
            <RelativeLayout
                android:layout_width="fill_parent"
                android:scrollbars="vertical"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:visibility="visible">



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/LL_settings"
                    android:weightSum="10"
                    android:layout_marginTop="10dp"
                    android:padding="10dp"
                    android:gravity="center"
                    android:layout_margin="3dp"
                    android:background="@drawable/groupbox"
                    >

                    <Button
                        android:id="@+id/button_offlinestats"
                        android:layout_width="0dp"
                        android:layout_weight="5"
                        android:textSize="14sp"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:layout_marginLeft="10dp"
                        android:gravity="center"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/round_corners"
                        android:baselineAligned="false"
                        android:drawableStart="@drawable/baseline_bar_chart_black_48dp"
                        android:textAllCaps="false"
                        android:padding="10dp"
                        android:text="@string/offlinestats"
                        android:textColor="@color/colorPrimaryDark" />

                    <Button

                        android:id="@+id/button_sync"
                        android:layout_width="0dp"
                        android:layout_weight="5"
                        android:textSize="14sp"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:layout_marginLeft="10dp"
                        android:gravity="center"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/round_corners"
                        android:baselineAligned="false"
                        android:textAllCaps="false"
                        android:drawableStart="@drawable/baseline_sync_black_24dp"
                        android:padding="10dp"
                        android:text="@string/sync"
                        android:textColor="@color/colorPrimaryDark" />



                </LinearLayout>



            </RelativeLayout>
        </ScrollView>


        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:id="@+id/LLuser"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="start"
                android:padding="5dp"
                android:text="@string/user_"
                android:textColor="@color/colorAccent"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textView_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="start"
                android:padding="5dp"
                android:text="@string/version_"
                android:textColor="@color/colorAccent"
                android:textSize="18sp"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_weight="1.0"
                android:gravity="bottom"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imageView_customer_logo"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="40.0"
                    android:adjustViewBounds="true"
                    android:background="@color/colorPrimary"
                    android:src="@drawable/logoo" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="5" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imageView_logo"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="40.0"
                    android:layout_marginRight="5dp"
                    android:layout_marginBottom="5dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/logoo" />
            </LinearLayout>
        </LinearLayout>
        <!--<Button

            android:id="@+id/button_settings"
            android:layout_width="150dp"
            android:layout_height="120dp"
            android:layout_below="@+id/button_collections"
            android:layout_centerHorizontal="true"
            android:layout_margin="10dp"
            android:background="@drawable/round_corners"
            android:baselineAligned="false"
            android:drawableLeft="@drawable/ic_settings_applications_black_48dp"
            android:padding="10dp"
            android:text="@string/settings"
            android:textColor="@color/colorPrimaryDark" />-->
    </RelativeLayout>

</RelativeLayout>

    <com.google.android.material.navigation.NavigationView
        android:layout_gravity="start"
        android:id="@+id/navigation"
        android:layout_width="wrap_content"
        android:layout_height="fill_parent"
        android:layout_marginTop="0.0dip"
        android:layout_alignParentTop="true"
        app:menu="@menu/main_menu" />
</androidx.drawerlayout.widget.DrawerLayout>