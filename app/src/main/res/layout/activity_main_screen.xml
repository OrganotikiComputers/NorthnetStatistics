<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    tools:context="organotiki.mobile.NorthnetStatistics.MainScreen">

    <include
        android:id="@+id/mainScreenBar"
        layout="@layout/main_screen_bar"
        android:baselineAligned="false" />



    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/mainScreenBar"
        android:baselineAligned="false"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        tools:context="organotiki.mobile.mobilestore.MainScreen">

        <ImageView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:src="@drawable/logoo_icon"
            android:alpha="0.1"
            android:scaleType="centerInside"
            >

        </ImageView>
        <Button

            android:id="@+id/button_offlinestats"
            android:layout_width="150dp"
            android:layout_height="120dp"
            android:layout_margin="10dp"
            android:background="@drawable/round_corners"
            android:baselineAligned="false"
            android:drawableTop="@drawable/baseline_bar_chart_black_48dp"
            android:padding="10dp"
            android:textAllCaps="false"
            android:text="@string/offlinestats"
            android:textColor="@color/colorPrimaryDark" />

        <Button

            android:id="@+id/button_sync"
            android:layout_width="150dp"
            android:layout_height="120dp"
            android:layout_margin="10dp"
            android:background="@drawable/round_corners"
            android:baselineAligned="false"
            android:drawableTop="@drawable/ic_sync_black_48dp"
            android:padding="10dp"
            android:layout_toEndOf="@+id/button_offlinestats"
            android:text="@string/sync"
            android:textAllCaps="false"
            android:textColor="@color/colorPrimaryDark" />



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/linearLayout_customer_logo"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0"
                android:gravity="start"
                android:orientation="vertical">

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="7" />


                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imageView_customer_logo"
                    android:layout_width="152dp"
                    android:layout_height="21dp"
                    android:layout_alignTop="@+id/imageView_logo"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentBottom="true"
                    android:layout_gravity="start"
                    android:layout_weight="1.5"
                    android:adjustViewBounds="true"
                    android:background="@color/colorPrimary"
                    android:src="@drawable/logoo" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout_user_details"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="50dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/textView_user"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:gravity="start"
                    android:padding="5dp"
                    android:text="@string/user_"
                    android:textColor="@color/colorAccent"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:gravity="start"
                    android:padding="5dp"
                    android:text="@string/version_"
                    android:textColor="@color/colorAccent"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:layout_weight="0"
                android:gravity="end"
                android:orientation="vertical">

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="7" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imageView_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginRight="5dp"
                    android:layout_marginBottom="5dp"
                    android:layout_gravity="end"
                    android:layout_weight="1"
                    android:adjustViewBounds="true"
                    android:src="@drawable/logoo" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>
</RelativeLayout>

